# Exemplo local. Não é carregado automaticamente; exporte antes de executar.
MOIRAE_ORIGIN=http://127.0.0.1:8000
MOIRAE_SECURE_COOKIE=false
MOIRAE_DB=var/moirae.sqlite3
# Checkout de teste: manter false até configurar contas de teste e origem HTTPS.
MOIRAE_MP_SANDBOX=false
MOIRAE_MP_ACCESS_TOKEN=
MOIRAE_MP_COLLECTOR_ID=
MOIRAE_MP_WEBHOOK_SECRET=

# Local demonstration only: fixed grades, no OpenAI calls or real credits.
MOIRAE_ESSAY_DEMO=false
